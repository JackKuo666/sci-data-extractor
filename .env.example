# Sci-Data-Extractor 环境变量配置示例
# 复制此文件为 .env 并填入你的实际配置

# ============================================
# 必需配置：LLM API
# ============================================

# Anthropic Claude API Key
# 获取地址: https://console.anthropic.com/
EXTRACTOR_API_KEY=your-anthropic-api-key-here

# API 端点（默认为 Anthropic 官方端点）
# 如果使用其他兼容服务（如 Azure OpenAI），请修改此项
EXTRACTOR_BASE_URL=https://api.anthropic.com

# ============================================
# 可选配置：Mathpix OCR
# ============================================

# Mathpix App ID
# 获取地址: https://api.mathpix.com/
# 如果不使用 Mathpix OCR，可以留空
MATHPIX_APP_ID=

# Mathpix App Key
MATHPIX_APP_KEY=

# ============================================
# 可选配置：默认参数
# ============================================

# 默认 LLM 模型
# 选项: claude-sonnet-4-5-20250929, gpt-4o-2024-08-06, 等
EXTRACTOR_MODEL=claude-sonnet-4-5-20250929

# 默认温度参数
# 范围: 0.0 - 1.0，越低越确定性，越高越创造性
EXTRACTOR_TEMPERATURE=0.1
